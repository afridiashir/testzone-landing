// Test Zone Diagnostic Centre — lab test catalogue and bookings.
//
// Postgres (Neon). DATABASE_URL is the pooled connection the app uses;
// DIRECT_URL bypasses the pooler, which Prisma Migrate needs.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model LabTest {
  id Int @id @default(autoincrement())

  /// URL segment, e.g. "hemoglobin-a1c-hba1c". Derived from `name`.
  slug String @unique
  /// Display name, with the redundant "( At Test Zone ... )" suffix stripped.
  name String
  /// Price in PKR. Null means the rate list carried no price — shown as
  /// "Price on request" rather than a misleading "PKR 0".
  rate Int?

  /// Department this test belongs to. Derived from the test name, since the
  /// rate list's own "Test Type" column is the same value for every row.
  category String
  /// Matching slug in src/data/departments.ts, when one exists.
  departmentSlug String?

  /// Turnaround, when the rate list supplies one.
  reportingDay String?

  /// Name as it appears in the source rate list, kept for reconciliation.
  sourceName String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  bookingItems BookingItem[]

  @@index([category])
  @@index([name])
}

/// A test booking placed from the website cart. Staff pick these up and
/// confirm with the patient by phone.
model Booking {
  id Int @id @default(autoincrement())

  /// Short code shown to the patient, e.g. "TZ-7K3QXP".
  reference String @unique

  patientName String
  phone       String
  age         Int
  city        String

  /// "LAB" (patient visits a centre) or "HOME" (home sample collection).
  preference String
  /// Required when preference is "HOME".
  address    String?

  /// Preferred date/time as entered, both optional.
  preferredDate String?
  preferredTime String?

  /// Sum of priced items in PKR at booking time. Tests with no published
  /// price are excluded and quoted by staff.
  subtotal Int

  /// "PENDING", "CONFIRMED", "COMPLETED" or "CANCELLED".
  status String @default("PENDING")

  items BookingItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([createdAt])
}

/// One line of a booking. Name and rate are copied at booking time so a later
/// rate-list reseed cannot change what the patient was quoted, and the link to
/// LabTest is dropped rather than blocking the reseed if a test is removed.
model BookingItem {
  id Int @id @default(autoincrement())

  bookingId Int
  booking   Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  labTestId Int?
  labTest   LabTest? @relation(fields: [labTestId], references: [id], onDelete: SetNull)

  name     String
  rate     Int?
  quantity Int

  @@index([bookingId])
}
